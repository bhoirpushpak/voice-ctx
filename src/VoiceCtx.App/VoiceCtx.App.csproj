<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\VoiceCtx.ico</ApplicationIcon>
    <AssemblyName>VoiceCtx</AssemblyName>
    <RootNamespace>VoiceCtx.App</RootNamespace>
    <AssemblyTitle>Voice CTX - Voice Change Transform Xpress</AssemblyTitle>
    <Product>Voice CTX</Product>
    <Description>Real-time voice changer for Windows: voice effects, noise cancellation, studio sound and AI voices.</Description>
    <Copyright>Copyright (c) 2026 Pushpak Bhoir</Copyright>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- `dotnet publish -p:PublishSingleFile=true`: one compressed exe, WPF native libraries included. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the tray icon uses WinForms; keep its namespaces out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VoiceCtx.ico" />
    <Resource Include="Assets\VoiceCtxOff.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceCtx.Audio\VoiceCtx.Audio.csproj" />
  </ItemGroup>

  <!-- ONNX Runtime's NuGet package ships its import library next to the DLL; it is build-time only. -->
  <Target Name="RemoveOnnxRuntimeImportLib" AfterTargets="Publish">
    <Delete Files="$(PublishDir)onnxruntime.lib" />
  </Target>

</Project>
