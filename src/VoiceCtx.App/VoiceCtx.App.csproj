<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\VoiceCtx.ico</ApplicationIcon>
    <AssemblyTitle>Voice CTX</AssemblyTitle>
    <Product>Voice CTX</Product>
  </PropertyGroup>

  <!-- `dotnet publish -p:PublishSingleFile=true`: one compressed exe, WPF native libraries included. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the tray icon uses WinForms; keep its namespaces out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VoiceCtx.ico" />
    <Resource Include="Assets\VoiceCtxOff.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceCtx.Audio\VoiceCtx.Audio.csproj" />
  </ItemGroup>

</Project>
