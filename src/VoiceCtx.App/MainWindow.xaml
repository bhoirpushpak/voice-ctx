<Window x:Class="VoiceCtx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoiceCtx.App.ViewModels"
        xmlns:app="clr-namespace:VoiceCtx.App"
        Title="Voice CTX" Width="920" Height="660" MinWidth="780" MinHeight="600"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/VoiceCtx.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:EngineStateBrushConverter x:Key="StateBrush" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PowerToggle}"
                          IsChecked="{Binding IsOn, Mode=TwoWay}" ToolTip="Turn the voice effect on or off (Ctrl+Alt+V)" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Voice CTX" FontSize="26" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Caption}" Margin="0"
                           Text="Real-time voice changer · use “CABLE Output” as your mic in Discord, games or OBS · Ctrl+Alt+V toggles" />
            </StackPanel>
        </DockPanel>

        <!-- Virtual cable missing -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14,10" CornerRadius="8"
                Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding CableMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="VB-Audio Virtual Cable is not installed." />
                <Run Text="Voice CTX sends your changed voice to “CABLE Input”, so other apps can pick “CABLE Output” as a microphone. Install it from" />
                <Hyperlink Command="{Binding OpenCableSiteCommand}" Foreground="{StaticResource WarningBrush}">
                    <Run Text="{Binding CableDownloadLink, Mode=OneWay}" />
                </Hyperlink>
                <Run Text=", then restart Voice CTX if the device does not appear." />
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Devices" />
                        <TextBlock Style="{StaticResource Caption}" Text="Microphone" />
                        <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Caption}" Text="Output (virtual cable)" />
                        <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Caption}" Text="Monitor (your headphones)" />
                        <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" Margin="0,0,0,10"
                                  IsEnabled="{Binding MonitorEnabled}" />
                        <CheckBox Content="Hear myself" IsChecked="{Binding MonitorEnabled}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Levels" />
                        <TextBlock Style="{StaticResource Caption}" Text="Input level" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding InputLevel, Mode=OneWay}" Margin="0,0,0,14" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding MasterVolume, StringFormat={}{0:0}%}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Master volume" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="200" Value="{Binding MasterVolume}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Voice effect" Margin="4,0,0,6" />
                    <Grid DockPanel.Dock="Bottom" Margin="4,12,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding CustomSemitonesText}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Custom pitch" />
                            </DockPanel>
                            <Slider Minimum="-12" Maximum="12" Value="{Binding CustomSemitones}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Mix, StringFormat={}{0:0}%}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Effect strength (dry / wet)" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Mix}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Effects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EffectOption}">
                                <RadioButton Style="{StaticResource EffectTile}" GroupName="Effects"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,14,0,0">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding EngineState, Converter={StaticResource StateBrush}}" />
            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="16,0,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding HotkeyWarning}" />
        </StackPanel>
    </Grid>
</Window>
