<Window x:Class="VoiceCtx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoiceCtx.App.ViewModels"
        xmlns:app="clr-namespace:VoiceCtx.App"
        Title="Voice CTX - Voice Change Transform Xpress" Width="920" Height="840" MinWidth="780" MinHeight="780"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/VoiceCtx.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <app:EngineStateBrushConverter x:Key="StateBrush" />

        <!-- Shared by Type to speak and Live translate: the voice lines are spoken in. -->
        <DataTemplate DataType="{x:Type vm:SpeechVoicesViewModel}">
            <StackPanel>
                <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="8"
                        Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        Visibility="{Binding ModelsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Speech models aren't installed yet." />
                        <Run Text="Build them with tools/tts/build_models.py, or extract the speech model pack into:" />
                        <LineBreak />
                        <Run Text="{Binding ModelFolder, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Text="Voice" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Style="{StaticResource ActionButton}" Content="{Binding RecordButtonText}" Command="{Binding RecordCommand}"
                                IsEnabled="{Binding ModelsInstalled}" ToolTip="Record about 10 seconds of your voice" />
                        <Button Style="{StaticResource ActionButton}" Content="Import…" Command="{Binding ImportCommand}"
                                IsEnabled="{Binding ModelsInstalled}" ToolTip="Use a WAV recording (5–20 seconds of clear speech)" />
                        <Button Style="{StaticResource ActionButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="0"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding Selected}" IsEnabled="{Binding ModelsInstalled}" />
                </DockPanel>

                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4" Text="Read this out loud in your normal voice, then click Stop:" />
                        <TextBlock Text="{Binding Script}" FontSize="15" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="10,0,0,0"
                                       Text="{Binding RecordedSeconds, StringFormat={}{0:0} s}" />
                            <ProgressBar Style="{StaticResource Meter}" VerticalAlignment="Center"
                                         Maximum="{Binding MaxSeconds}" Value="{Binding RecordedSeconds, Mode=OneWay}" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,6,0,0"
                                     Value="{Binding DataContext.InputLevel, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Text="{Binding Message}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Consent}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PowerToggle}"
                          IsChecked="{Binding IsOn, Mode=TwoWay}" ToolTip="Turn the voice effect on or off (Ctrl+Alt+V)" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Voice CTX" FontSize="26" FontWeight="Bold" />
                <TextBlock Style="{StaticResource Caption}" Margin="0" TextWrapping="Wrap"
                           Text="Use “CABLE Output” as your mic · Hotkeys Ctrl+Alt + V effects · N noise cancel · A AI voice · T type to speak · L translate" />
            </StackPanel>
        </DockPanel>

        <!-- Virtual cable missing -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14,10" CornerRadius="8"
                Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding CableMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="VB-Audio Virtual Cable is not installed." />
                <Run Text="Voice CTX sends your changed voice to “CABLE Input”, so other apps can pick “CABLE Output” as a microphone. Install it from" />
                <Hyperlink Command="{Binding OpenCableSiteCommand}" Foreground="{StaticResource WarningBrush}">
                    <Run Text="{Binding CableDownloadLink, Mode=OneWay}" />
                </Hyperlink>
                <Run Text=", then restart Voice CTX if the device does not appear." />
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Devices" />
                        <TextBlock Style="{StaticResource Caption}" Text="Microphone" />
                        <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Caption}" Text="Output (virtual cable)" />
                        <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Caption}" Text="Monitor (your headphones)" />
                        <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" Margin="0,0,0,10"
                                  IsEnabled="{Binding MonitorEnabled}" />
                        <CheckBox Content="Hear myself" IsChecked="{Binding MonitorEnabled}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Levels" />
                        <TextBlock Style="{StaticResource Caption}" Text="Input level" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding InputLevel, Mode=OneWay}" Margin="0,0,0,14" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding MasterVolume, StringFormat={}{0:0}%}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Master volume" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="200" Value="{Binding MasterVolume}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Mic enhancement" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                   Text="Cleans up your mic before the voice effect" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0"
                                       Text="{Binding NoiseReduction, StringFormat={}{0:0}%}" />
                            <CheckBox Content="Noise cancellation" IsChecked="{Binding NoiseCancel}"
                                      IsEnabled="{Binding NoiseCancelSupported}"
                                      ToolTip="AI noise removal (RNNoise): fans, keyboard, background chatter · Ctrl+Alt+N" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding NoiseReduction}" Margin="0,6,0,12"
                                IsEnabled="{Binding NoiseCancel}" />

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0"
                                       Text="{Binding StudioStrength, StringFormat={}{0:0}%}" />
                            <CheckBox Content="Studio sound" IsChecked="{Binding StudioSound}"
                                      ToolTip="Broadcast mic chain: rumble filter, gate, EQ, de-esser, compressor and limiter" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" Value="{Binding StudioStrength}" Margin="0,6,0,0"
                                IsEnabled="{Binding StudioSound}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl>
                    <TabItem Header="Voice effects">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="4,12,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding CustomSemitonesText}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Custom pitch" />
                                    </DockPanel>
                                    <Slider Minimum="-12" Maximum="12" Value="{Binding CustomSemitones}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Mix, StringFormat={}{0:0}%}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Effect strength (dry / wet)" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Mix}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Effects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EffectOption}">
                                        <RadioButton Style="{StaticResource EffectTile}" GroupName="Effects"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="AI Voice" DataContext="{Binding AiVoice}">
                        <DockPanel>
                            <!-- Header: what it is + on/off -->
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PowerToggle}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding ModelsInstalled}"
                                              ToolTip="Turn AI Voice on or off (Ctrl+Alt+A)" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Sound like someone else" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0"
                                               Text="Real-time AI voice conversion. Your words and timing stay yours; the voice changes. Works with any language. Voice effects still apply on top." />
                                </StackPanel>
                            </DockPanel>

                            <!-- Footer: notice, actions, status -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding PitchShiftText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Pitch shift (tip: +12 when a male speaker uses a female voice, −12 the other way)" />
                                </DockPanel>
                                <Slider Minimum="-12" Maximum="12" Value="{Binding PitchShift}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource ActionButton}" Content="Import voice…" Command="{Binding ImportCommand}" />
                                    <Button Style="{StaticResource ActionButton}" Content="Open voices folder" Command="{Binding OpenFolderCommand}" />
                                    <Button Style="{StaticResource ActionButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                                    <Button Style="{StaticResource ActionButton}" Content="Credits" Command="{Binding OpenCreditsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ImportError}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Notice}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="AiDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource MutedTextBrush}" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Models missing -->
                            <Border DockPanel.Dock="Top" Margin="4,0,4,12" Padding="14,10" CornerRadius="8"
                                    Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Visibility="{Binding ShowInstallHelp, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="AI Voice models aren't installed yet." />
                                    <Run Text="They're large (~800 MB) so they aren't part of the app. Build them once with tools/aivoice/build_models.py (see the README), or copy a prepared model folder to:" />
                                    <LineBreak />
                                    <Run Text="{Binding ModelFolder, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                            </Border>

                            <!-- Voice list -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Voices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AiVoiceOption}">
                                            <RadioButton Style="{StaticResource EffectTile}" GroupName="AiVoices"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Credits}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem x:Name="TypeToSpeakTab" DataContext="{Binding TypeToSpeak}">
                        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Type to speak" VerticalAlignment="Center" /><Border Style="{StaticResource BetaBadge}"><TextBlock Text="BETA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" /></Border></StackPanel></TabItem.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Say it without speaking" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0"
                                           Text="Type a line and press Enter. It's spoken into your mic in your chosen voice, and voice effects still apply. Ctrl+Alt+T jumps here from anywhere." />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10" HorizontalAlignment="Left" Width="220">
                                <TextBlock Style="{StaticResource Caption}" Text="Language" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                            </StackPanel>
                            <ContentControl DockPanel.Dock="Top" Margin="4,0,4,12" Content="{Binding Voices}" Focusable="False" />

                            <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SpeakBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" MaxHeight="120"
                                         TextWrapping="Wrap" AcceptsReturn="True" PreviewKeyDown="OnSpeakBoxKeyDown"
                                         ToolTip="Enter = speak · Shift+Enter = new line · Esc = stop" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <Button Style="{StaticResource ActionButton}" Content="Speak" Command="{Binding SpeakCommand}" Margin="0,0,0,6" MinWidth="80" />
                                    <Button Style="{StaticResource ActionButton}" Content="Stop" Command="{Binding StopCommand}" Margin="0" MinWidth="80" />
                                </StackPanel>
                            </Grid>

                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="320" />
                                <CheckBox Content="Mute my mic while a line is spoken" IsChecked="{Binding MuteMic}" />
                            </DockPanel>

                            <DockPanel Margin="4,0,4,0">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="Recent lines (click to say again)" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpokenLine}">
                                                <Button Style="{StaticResource ActionButton}" Command="{Binding ReplayCommand}"
                                                        Margin="0,0,0,6" HorizontalContentAlignment="Left">
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </TabItem>

                    <TabItem DataContext="{Binding LiveTranslate}">
                        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Live translate" VerticalAlignment="Center" /><Border Style="{StaticResource BetaBadge}"><TextBlock Text="BETA" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" /></Border></StackPanel></TabItem.Header>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PowerToggle}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding ModelsInstalled}"
                                              ToolTip="Turn Live translate on or off (Ctrl+Alt+L)" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Speak one language, be heard in another" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0"
                                               Text="When you pause, what you said is translated and spoken into your mic in your chosen voice. Use headphones so the translation isn't picked up by your mic." />
                                </StackPanel>
                            </DockPanel>

                            <Border DockPanel.Dock="Top" Margin="4,0,4,12" Padding="14,10" CornerRadius="8"
                                    Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Visibility="{Binding ModelsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Live translate models aren't installed yet." />
                                    <Run Text="Download the translator model pack (~1.6 GB) from the Releases page and extract it into:" />
                                    <LineBreak />
                                    <Run Text="{Binding ModelFolder, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                            </Border>

                            <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="I speak" />
                                    <ComboBox ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding From}" MaxDropDownHeight="360" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Caption}" Text="Translate into" />
                                    <ComboBox ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding To}" MaxDropDownHeight="360" />
                                </StackPanel>
                            </Grid>

                            <ContentControl DockPanel.Dock="Top" Margin="4,0,4,10" Content="{Binding Voices}" Focusable="False" />

                            <Border DockPanel.Dock="Top" Margin="4,0,4,10" Padding="12,8" CornerRadius="8"
                                    Background="#33F2A93B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Visibility="{Binding NoVoiceForTarget, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="No speech model is installed for this language, so translations are only shown as text." />
                            </Border>

                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionButton}" Content="Clear" Command="{Binding ClearCommand}" />
                                    <Button Style="{StaticResource ActionButton}" Content="Credits" Command="{Binding OpenCreditsCommand}" Margin="0" />
                                </StackPanel>
                                <CheckBox Content="Keep my real voice quietly underneath" IsChecked="{Binding KeepOriginal}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Margin="4,8,4,0" Foreground="{StaticResource AccentBrush}" Text="{Binding Status}" TextWrapping="Wrap" />

                            <ScrollViewer Margin="4,0,4,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Subtitles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SubtitleLine}">
                                            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0" Text="{Binding Time}" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0" Text="{Binding Languages}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Original}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Translation}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,14,0,0">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding EngineState, Converter={StaticResource StateBrush}}" />
            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="16,0,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding HotkeyWarning}" />
        </StackPanel>
    </Grid>
</Window>
