<Window x:Class="VoiceCtx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice CTX" Width="460" SizeToContent="Height" ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="Microphone" />
        <ComboBox x:Name="InputBox" Margin="0,2,0,8" />
        <TextBlock Text="Output (virtual cable)" />
        <ComboBox x:Name="OutputBox" Margin="0,2,0,8" />
        <TextBlock Text="Monitor (headphones)" />
        <ComboBox x:Name="MonitorBox" Margin="0,2,0,4" />
        <CheckBox x:Name="MonitorCheck" Content="Monitor my voice" Margin="0,0,0,8" />
        <TextBlock Text="Input level" />
        <ProgressBar x:Name="LevelBar" Height="10" Maximum="1" Margin="0,2,0,8" />
        <TextBlock Text="Volume" />
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="2" Value="1" Margin="0,2,0,8"
                ValueChanged="OnVolumeChanged" />
        <Button x:Name="StartButton" Content="Start" Padding="8,4" Click="OnStartStop" />
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
