<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceCtx.Tests" />
  </ItemGroup>

  <!-- RNNoise (BSD-3-Clause), built by native/build-rnnoise.ps1. -->
  <ItemGroup>
    <None Include="Native\rnnoise.dll" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\RNNOISE-LICENSE.txt" Link="RNNOISE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
